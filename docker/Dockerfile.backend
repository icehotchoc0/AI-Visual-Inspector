FROM python:3.11-slim

WORKDIR /app

# opencv needs these system libs even in "headless" mode
RUN apt-get update && apt-get install -y --no-install-recommends \
    libgl1 libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt requirements-anomaly.txt ./
RUN pip install --no-cache-dir -r requirements.txt "psycopg[binary]>=3.1"
# Optional: anomaly-detection plugin (large; CPU torch). Build with
#   docker compose build --build-arg ANOMALY=1
ARG ANOMALY=0
RUN if [ "$ANOMALY" = "1" ]; then pip install --no-cache-dir -r requirements-anomaly.txt; fi

COPY backend/ backend/
COPY config/ config/
COPY training/ training/
COPY scripts/ scripts/

EXPOSE 8000
CMD ["uvicorn", "backend.app:app", "--host", "0.0.0.0", "--port", "8000"]
