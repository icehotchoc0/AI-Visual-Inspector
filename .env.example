# ---- Service ----
API_HOST=0.0.0.0
API_PORT=8000
# Comma-separated API keys accepted in X-API-Key. EMPTY = auth disabled (dev only!)
INSPECTOR_API_KEYS=
INSPECTOR_DB_PATH=./backend/data/inspector.db
# 카테고리 설정 폴더 (config/categories/<그룹>/<id>.yaml). 단일 YAML 경로도 허용
INSPECTOR_CATEGORIES_PATH=./config/categories
MAX_PHOTOS_PER_JOB=30
# SQLAlchemy URL. Empty = SQLite file at INSPECTOR_DB_PATH. Multiple instances: PostgreSQL 14+
INSPECTOR_DATABASE_URL=
# Photo retention for the review queue. Empty dir = keep no photos. policy: review_only | all | off
INSPECTOR_PHOTO_STORE_DIR=
INSPECTOR_PHOTO_STORE_POLICY=review_only
INSPECTOR_PHOTO_RETENTION_DAYS=90
# Browser origins allowed by CORS (operator dashboard domain). Empty = none. Never "*" in production
INSPECTOR_CORS_ORIGINS=
# Requests per minute per API key (or client IP without auth). 0 = off
INSPECTOR_RATE_LIMIT_PER_MINUTE=120
# Async queue workers in this process (0 on API-only replicas; >0 on worker processes)
INSPECTOR_QUEUE_WORKERS=2
# HMAC secret for callback signatures (X-Inspector-Signature). Empty = unsigned
INSPECTOR_WEBHOOK_SECRET=
# One-line JSON logs for log shippers
INSPECTOR_LOG_JSON=true
INSPECTOR_LOG_LEVEL=INFO
INSPECTOR_METRICS_ENABLED=true

# ---- VLM providers (ordered; first working provider wins) ----
# claude,ollama  = Claude API primary + local Qwen2.5-VL fallback (recommended)
# claude         = Claude only
# ollama         = local only (no cloud)
INSPECTOR_VLM_PROVIDERS=claude,ollama
VLM_ENABLED=true
# Global cap on simultaneous VLM calls (match provider rate limits). 0 = unlimited
INSPECTOR_VLM_MAX_CONCURRENCY=4
# Per-inspection token budget across all VLM calls. 0 = unlimited. Beyond it photos are skipped -> REVIEW
INSPECTOR_VLM_MAX_TOKENS_PER_JOB=0
# Circuit breaker: skip a provider after N consecutive failures for the cooldown. 0 = off
INSPECTOR_VLM_BREAKER_FAILURES=5
INSPECTOR_VLM_BREAKER_COOLDOWN_S=60
# Privacy: never send photos to a cloud VLM (also per category privacy.local_only / per request options.local_only)
INSPECTOR_VLM_LOCAL_ONLY=false

# Claude - the Anthropic SDK reads ANTHROPIC_API_KEY from the environment.
# INSPECTOR_ANTHROPIC_API_KEY is an optional override for containers that
# inject the secret under a different name.
ANTHROPIC_API_KEY=
INSPECTOR_ANTHROPIC_API_KEY=
INSPECTOR_CLAUDE_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max  (thinking depth / token spend)
INSPECTOR_CLAUDE_EFFORT=medium
CLAUDE_MAX_TOKENS=8192
# Mark the per-category system block cacheable (prompt caching, ~10% input price on repeats)
INSPECTOR_CLAUDE_PROMPT_CACHE=true
CLAUDE_TIMEOUT_S=120

# Ollama (local fallback). NOTE: INSPECTOR_OLLAMA_HOST, not OLLAMA_HOST - the
# latter is Ollama's own *server bind* variable and must not be reused here.
INSPECTOR_OLLAMA_HOST=http://localhost:11434
INSPECTOR_OLLAMA_MODEL=qwen2.5vl:7b
OLLAMA_TIMEOUT_S=180

# ---- Optional anomaly-detection plugin (Anomalib) ----
AD_BACKEND=patchcore
AD_CHECKPOINT_DIR=./backend/data/checkpoints
ANOMALY_THRESHOLD=0.5

# ---- Training data (docs/DATA_SPEC.md) ----
INSPECTOR_DATASET_ROOT=./backend/data/datasets
# Legacy MVTec AD benchmark
MVTEC_ROOT=./backend/data/mvtec_ad
MVTEC_CATEGORIES=bottle,cable,metal_nut,screw

# ---- docker/docker-compose.prod.yml only ----
POSTGRES_PASSWORD=
# API key the dashboard container uses (must be one of INSPECTOR_API_KEYS)
INSPECTOR_DASHBOARD_API_KEY=
