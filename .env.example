# ---- Ollama / VLM ----
OLLAMA_HOST=http://localhost:11434
VLM_MODEL=qwen2.5vl:7b
VLM_ENABLED=true

# ---- Anomaly detection ----
# Which backbone to serve by default: patchcore | efficient_ad
AD_BACKEND=patchcore
AD_CHECKPOINT_DIR=./backend/data/checkpoints
# Image-level anomaly score above this threshold => classified as defective
ANOMALY_THRESHOLD=0.5

# ---- Dataset ----
MVTEC_ROOT=./backend/data/mvtec_ad
MVTEC_CATEGORIES=bottle,cable,metal_nut,screw

# ---- API ----
API_HOST=0.0.0.0
API_PORT=8000

# ---- Notification (optional, mirrors AI-Portfolio-Agent pattern) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
NOTIFY_EMAIL=
