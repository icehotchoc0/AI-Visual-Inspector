# ---- Service ----
API_HOST=0.0.0.0
API_PORT=8000
# Comma-separated API keys accepted in X-API-Key. EMPTY = auth disabled (dev only!)
INSPECTOR_API_KEYS=
INSPECTOR_DB_PATH=./backend/data/inspector.db
# 카테고리 설정 폴더 (config/categories/<그룹>/<id>.yaml). 단일 YAML 경로도 허용
INSPECTOR_CATEGORIES_PATH=./config/categories
MAX_PHOTOS_PER_JOB=30

# ---- VLM providers (ordered; first working provider wins) ----
# claude,ollama  = Claude API primary + local Qwen2.5-VL fallback (recommended)
# claude         = Claude only
# ollama         = local only (no cloud)
INSPECTOR_VLM_PROVIDERS=claude,ollama
VLM_ENABLED=true

# Claude - the Anthropic SDK reads ANTHROPIC_API_KEY from the environment.
# INSPECTOR_ANTHROPIC_API_KEY is an optional override for containers that
# inject the secret under a different name.
ANTHROPIC_API_KEY=
INSPECTOR_ANTHROPIC_API_KEY=
INSPECTOR_CLAUDE_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max  (thinking depth / token spend)
INSPECTOR_CLAUDE_EFFORT=medium
CLAUDE_MAX_TOKENS=8192
CLAUDE_TIMEOUT_S=120

# Ollama (local fallback). NOTE: INSPECTOR_OLLAMA_HOST, not OLLAMA_HOST - the
# latter is Ollama's own *server bind* variable and must not be reused here.
INSPECTOR_OLLAMA_HOST=http://localhost:11434
INSPECTOR_OLLAMA_MODEL=qwen2.5vl:7b
OLLAMA_TIMEOUT_S=180

# ---- Optional anomaly-detection plugin (Anomalib) ----
AD_BACKEND=patchcore
AD_CHECKPOINT_DIR=./backend/data/checkpoints
ANOMALY_THRESHOLD=0.5

# ---- Training data (docs/DATA_SPEC.md) ----
INSPECTOR_DATASET_ROOT=./backend/data/datasets
# Legacy MVTec AD benchmark
MVTEC_ROOT=./backend/data/mvtec_ad
MVTEC_CATEGORIES=bottle,cable,metal_nut,screw
